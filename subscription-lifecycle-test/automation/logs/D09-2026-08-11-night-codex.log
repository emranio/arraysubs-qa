+SLT_SUB_OK=$(wp db query "SELECT COUNT(*) FROM wp_posts p JOIN wp_postmeta parent ON parent.post_id=p.ID AND parent.meta_key='_parent_order_id' JOIN wp_postmeta customer ON customer.post_id=p.ID AND customer.meta_key='_customer_id' JOIN wp_postmeta product ON product.post_id=p.ID AND product.meta_key='_product_id' JOIN wp_postmeta payments ON payments.post_id=p.ID AND payments.meta_key='_completed_payments' JOIN wp_postmeta nextpay ON nextpay.post_id=p.ID AND nextpay.meta_key='_next_payment_date' LEFT JOIN wp_postmeta pending ON pending.post_id=p.ID AND pending.meta_key='_pending_renewal_order_id' WHERE (p.ID=12172 AND p.post_status='arraysubs-active' AND parent.meta_value='12162' AND customer.meta_value='354' AND product.meta_value='12099' AND payments.meta_value='3' AND nextpay.meta_value='2026-08-11 18:00:00' AND pending.meta_value='13788') OR (p.ID=12193 AND p.post_status='arraysubs-active' AND parent.meta_value='12183' AND customer.meta_value='355' AND product.meta_value='12102' AND payments.meta_value='2' AND nextpay.meta_value='2026-08-11 18:00:00' AND pending.meta_value='13805') OR (p.ID=11991 AND p.post_status='arraysubs-active' AND parent.meta_value='11990' AND customer.meta_value='357' AND product.meta_value='11927' AND payments.meta_value='9' AND nextpay.meta_value='2026-08-11 13:23:13' AND pending.meta_value='13808') OR (p.ID=12039 AND p.post_status='arraysubs-active' AND parent.meta_value='12029' AND customer.meta_value='350' AND product.meta_value='11943' AND payments.meta_value='2' AND nextpay.meta_value='2026-08-14 18:00:00') OR (p.ID=12749 AND p.post_status='arraysubs-active' AND parent.meta_value='12748' AND customer.meta_value='365' AND product.meta_value='12737' AND payments.meta_value='2' AND nextpay.meta_value='2026-08-14 18:00:00')" --skip-column-names --allow-root)
+
