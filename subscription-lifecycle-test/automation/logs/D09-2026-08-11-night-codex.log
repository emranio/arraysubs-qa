+wp db query "SELECT o.id,o.status,o.customer_id,o.total_amount,o.currency,o.payment_method,GROUP_CONCAT(CONCAT(m.meta_key,'=',m.meta_value) ORDER BY m.meta_key SEPARATOR ' | ') AS relationship FROM wp_wc_orders o JOIN wp_wc_orders_meta m ON m.order_id=o.id AND m.meta_key IN ('_is_renewal_order','_subscription_id','_subscription_renewal','_renewal_cycle_number','_renewal_scheduled_date') WHERE o.id IN (13788,13805,13808) GROUP BY o.id,o.status,o.customer_id,o.total_amount,o.currency,o.payment_method ORDER BY o.id" --allow-root
+echo 'mailpit_recent_at_capture='
