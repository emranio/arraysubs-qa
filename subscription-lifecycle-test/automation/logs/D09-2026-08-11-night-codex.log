  fi
  SLT_SLEEP=55
  if [ "$SLT_REMAINING" -lt "$SLT_SLEEP" ]; then
    SLT_SLEEP=$SLT_REMAINING
  fi
  sleep "$SLT_SLEEP"
done' in /home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
