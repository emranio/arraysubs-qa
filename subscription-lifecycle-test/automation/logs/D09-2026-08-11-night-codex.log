+printf '%s\n' "$SLT_PRE_MARKERS"
+echo "validated_cardinality actions=$SLT_ACTION_OK orders=$SLT_ORDER_OK subscriptions=$SLT_SUB_OK"
+
+wp db query "SELECT p.ID,p.post_status,parent.meta_value AS parent_order,customer.meta_value AS customer_id,product.meta_value AS product_id,payments.meta_value AS payments,nextpay.meta_value AS next_payment,pending.meta_value AS pending_order,remfor.meta_value AS reminder_sent_for,remat.meta_value AS reminder_sent_at FROM wp_posts p LEFT JOIN wp_postmeta parent ON parent.post_id=p.ID AND parent.meta_key='_parent_order_id' LEFT JOIN wp_postmeta customer ON customer.post_id=p.ID AND customer.meta_key='_customer_id' LEFT JOIN wp_postmeta product ON product.post_id=p.ID AND product.meta_key='_product_id' LEFT JOIN wp_postmeta payments ON payments.post_id=p.ID AND payments.meta_key='_completed_payments' LEFT JOIN wp_postmeta nextpay ON nextpay.post_id=p.ID AND nextpay.meta_key='_next_payment_date' LEFT JOIN wp_postmeta pending ON pending.post_id=p.ID AND pending.meta_key='_pending_renewal_order_id' LEFT JOIN wp_postmeta remfor ON remfor.post_id=p.ID AND remfor.meta_key='_arraysubs_renewal_reminder_sent_for' LEFT JOIN wp_postmeta remat ON remat.post_id=p.ID AND remat.meta_key='_arraysubs_renewal_reminder_sent_at' WHERE p.ID IN (11991,12039,12172,12193,12749) ORDER BY p.ID" --allow-root
