+
+echo "capture_site_before=$SLT_SITE_BEFORE"
+echo "capture_utc_before=$SLT_UTC_BEFORE"
+echo "mailpit_cursor=$SLT_CURSOR"
+echo "capture_site_after=$SLT_SITE_AFTER"
+echo "capture_utc_after=$SLT_UTC_AFTER"
