+agent-browser click "$SLT_SAVE_REF" >/dev/null
+agent-browser wait --text 'Page updated' >/dev/null
+agent-browser screenshot "$SLT_EVIDENCE_ROOT/SLT-SYN-09-D09-registry-baseline.png" >/dev/null
+
+SLT_CACHEBUSTER=$(date -u +%s)
+agent-browser open "$SLT_REGISTRY_PRIVATE?slt_cb=$SLT_CACHEBUSTER" >/dev/null
+agent-browser snapshot -i >/dev/null
+SLT_READBACK_TEXT=$(agent-browser get text body)
+for SLT_MARKER in SYN09_2SEG_D10_PRE D10_NC_PRE D10_CORE2_PRE D10_W1_REM_PRE D10_WQ_REM_PRE; do
+  if [[ "$SLT_READBACK_TEXT" != *"$SLT_MARKER=$SLT_CURSOR"* ]]; then
+    echo "ABORT: browser readback missing $SLT_MARKER"
+    exit 1
+  fi
+  echo "browser_readback $SLT_MARKER=present"
+done
+agent-browser press End >/dev/null
+agent-browser wait 500 >/dev/null
+agent-browser screenshot "$SLT_EVIDENCE_ROOT/SLT-SYN-09-D09-registry-readback.png" >/dev/null
+
+SLT_POST_HASH=$(wp post get 11847 --field=post_content --allow-root | sha256sum | awk '{print $1}')
+SLT_POST_BYTES=$(wp post get 11847 --field=post_content --allow-root | wc -c | tr -d ' ')
+SLT_POST_MARKERS=$(wp eval '
+$content=get_post_field("post_content",11847,"raw");
+foreach (["SYN09_2SEG_D10_PRE","D10_NC_PRE","D10_CORE2_PRE","D10_W1_REM_PRE","D10_WQ_REM_PRE"] as $needle) {
+  echo $needle . "=" . substr_count($content,$needle) . "\\n";
+}
+' --allow-root)
+if printf '%s\n' "$SLT_POST_MARKERS" | rg -v '=1$' >/dev/null; then
+  echo 'ABORT: post-save marker cardinality is not exactly one'
+  printf '%s\n' "$SLT_POST_MARKERS"
+  exit 1
+fi
+
+echo "registry_post_hash=$SLT_POST_HASH"
+echo "registry_post_bytes=$SLT_POST_BYTES"
+printf '%s\n' "$SLT_POST_MARKERS"
+echo "registry_editor_screenshot=$SLT_EVIDENCE_ROOT/SLT-SYN-09-D09-registry-baseline.png"
+echo "registry_readback_screenshot=$SLT_EVIDENCE_ROOT/SLT-SYN-09-D09-registry-readback.png"
+echo 'handoff_capture=COMPLETE'
