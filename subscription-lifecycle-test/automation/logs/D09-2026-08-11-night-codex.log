+#!/usr/bin/env bash
+set -euo pipefail
+
+SLT_WP_ROOT=/home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
+SLT_EVIDENCE_ROOT=/home/server-manager/slt-evidence
+SLT_AUTH_STATE=/tmp/SLT-SYN-09-D9-admin-auth.json
+SLT_REGISTRY_EDITOR='https://mirror-help.arrayhash.com/wp-admin/post.php?post=11847&action=edit'
+SLT_REGISTRY_PRIVATE='https://mirror-help.arrayhash.com/slt-catalog-registry/'
+SLT_TARGET_UTC='2026-08-11T18:06:39Z'
+
+export AGENT_BROWSER_SESSION=admin-SLT-SYN-09-D9
+
+slt_close_browser() {
+  agent-browser close >/dev/null 2>&1 || true
+}
+trap slt_close_browser EXIT
+
+cd "$SLT_WP_ROOT"
+
+agent-browser --state "$SLT_AUTH_STATE" open "$SLT_REGISTRY_EDITOR" >/dev/null
+SLT_EDITOR_SNAPSHOT=$(agent-browser snapshot -i)
+SLT_EDITOR_REF=$(printf '%s\n' "$SLT_EDITOR_SNAPSHOT" | sed -n 's/.*textbox "Type text or HTML".*\[ref=\([^]]*\)\].*/@\1/p' | sed -n '1p')
+if [ -z "$SLT_EDITOR_REF" ]; then
+  echo 'ABORT: registry code-editor textbox ref was not found'
+  exit 1
+fi
+echo "browser_prepared session=$AGENT_BROWSER_SESSION editor_ref=$SLT_EDITOR_REF"
+
+SLT_TARGET_EPOCH=$(date -u -d "$SLT_TARGET_UTC" +%s)
+while true; do
+  SLT_NOW_EPOCH=$(date -u +%s)
+  SLT_REMAINING=$((SLT_TARGET_EPOCH-SLT_NOW_EPOCH))
+  SLT_SITE_POLL=$(wp eval 'echo wp_date("Y-m-d H:i:s");' --allow-root 2>/dev/null)
+  SLT_UTC_POLL=$(date -u '+%Y-%m-%d %H:%M:%S')
+  echo "gate poll site=$SLT_SITE_POLL utc=$SLT_UTC_POLL remaining=$SLT_REMAINING seconds"
+  if [ "$SLT_REMAINING" -le 0 ]; then
+    break
+  fi
+  SLT_SLEEP=30
+  if [ "$SLT_REMAINING" -lt "$SLT_SLEEP" ]; then
+    SLT_SLEEP=$SLT_REMAINING
+  fi
+  sleep "$SLT_SLEEP"
+done
+
+SLT_SITE_BEFORE=$(wp eval 'echo wp_date("Y-m-d H:i:s");' --allow-root)
+SLT_UTC_BEFORE=$(date -u '+%Y-%m-%d %H:%M:%S')
+SLT_CURSOR=$(/usr/local/bin/mailpit-agent latest-id)
+SLT_SITE_AFTER=$(wp eval 'echo wp_date("Y-m-d H:i:s");' --allow-root)
+SLT_UTC_AFTER=$(date -u '+%Y-%m-%d %H:%M:%S')
+
+if [ -z "$SLT_CURSOR" ]; then
+  echo 'ABORT: Mailpit latest-id returned empty'
+  exit 1
+fi
+if [ "$(date -u +%s)" -ge "$(date -u -d '2026-08-11T18:11:39Z' +%s)" ]; then
+  echo 'ABORT: capture crossed the natural charge gate'
+  exit 1
+fi
+
+SLT_PRE_HASH=$(wp post get 11847 --field=post_content --allow-root | sha256sum | awk '{print $1}')
+SLT_PRE_BYTES=$(wp post get 11847 --field=post_content --allow-root | wc -c | tr -d ' ')
+SLT_PRE_MARKERS=$(wp eval '
+$content=get_post_field("post_content",11847,"raw");
+foreach (["SYN09_2SEG_D10_PRE","D10_NC_PRE","D10_CORE2_PRE","D10_W1_REM_PRE","D10_WQ_REM_PRE"] as $needle) {
+  echo $needle . "=" . substr_count($content,$needle) . "\n";
+}
+' --allow-root)
+if printf '%s\n' "$SLT_PRE_MARKERS" | rg -v '=0$' >/dev/null; then
+  echo 'ABORT: at least one registry marker already exists'
+  printf '%s\n' "$SLT_PRE_MARKERS"
+  exit 1
