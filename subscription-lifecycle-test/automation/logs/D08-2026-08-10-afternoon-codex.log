# capture the id BEFORE the trigger, then wait
PREV=$(/usr/local/bin/mailpit-agent latest-id)
# … trigger …
/usr/local/bin/mailpit-agent wait-new "$PREV" 60 "renews soon"   # exit 124 = timeout
/usr/local/bin/mailpit-agent text latest
```


