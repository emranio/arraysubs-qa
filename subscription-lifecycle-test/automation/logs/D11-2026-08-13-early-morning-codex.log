SELECT 'CANCEL_POST_ACTIVITY_ORDER' AS section,c.id,o.id AS order_id,o.status,o.type,o.date_created_gmt,m.meta_key,m.meta_value
FROM cancels c JOIN wp_wc_orders_meta m ON m.meta_value=CAST(c.id AS CHAR) AND m.meta_key IN ('_subscription_id','_subscription_renewal')
JOIN wp_wc_orders o ON o.id=m.order_id AND o.date_created_gmt>c.cancelled
ORDER BY c.id,o.date_created_gmt;

SELECT 'TAIL_ORDERS_SINCE_D10_CURSOR' AS section,m.meta_value AS sub_id,o.id AS order_id,o.status,o.type,o.date_created_gmt,m.meta_key
FROM wp_wc_orders_meta m JOIN wp_wc_orders o ON o.id=m.order_id
WHERE m.meta_key IN ('_subscription_id','_subscription_renewal') AND m.meta_value IN ('12003','12039','12172','12564','12749','12786','13277') AND o.date_created_gmt>'2026-08-12 15:22:06'
ORDER BY o.date_created_gmt;

SELECT 'FAILED_ARRAYSUBS_LAST36H' AS section,action_id,hook,status,scheduled_date_gmt,last_attempt_gmt,args
FROM wp_actionscheduler_actions
WHERE hook LIKE 'arraysubs_%' AND status='failed' AND COALESCE(NULLIF(last_attempt_gmt,'0000-00-00 00:00:00'),scheduled_date_gmt)>=UTC_TIMESTAMP()-INTERVAL 36 HOUR
ORDER BY action_id;

SELECT 'SLT_ON_HOLD' AS section,p.ID,pr.post_title
FROM wp_posts p
JOIN wp_postmeta product_meta ON product_meta.post_id=p.ID AND product_meta.meta_key='_product_id'
JOIN wp_posts pr ON pr.ID=CAST(product_meta.meta_value AS UNSIGNED) AND pr.post_title LIKE 'SLT %'
WHERE p.post_type='arraysubs_data' AND p.post_status='arraysubs-on-hold';

SELECT 'NON_SLT_CONTROLS' AS section,p.ID,p.post_status,
 MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END) AS next_payment,
 MAX(CASE WHEN pm.meta_key='_completed_payments' THEN pm.meta_value END) AS completed_payments
FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID
WHERE p.ID IN (648,7353,7809,8034,8682,8705,8728,8751,8776,8805,8969,8992,9092)
GROUP BY p.ID,p.post_status ORDER BY p.ID;

SELECT 'NEW_SLT_SUBS_SINCE_D10_CURSOR' AS section,p.ID,p.post_status,p.post_date_gmt,pr.post_title,u.user_email
FROM wp_posts p
JOIN wp_postmeta product_meta ON product_meta.post_id=p.ID AND product_meta.meta_key='_product_id'
JOIN wp_posts pr ON pr.ID=CAST(product_meta.meta_value AS UNSIGNED) AND pr.post_title LIKE 'SLT %'
LEFT JOIN wp_postmeta customer_meta ON customer_meta.post_id=p.ID AND customer_meta.meta_key='_customer_id'
LEFT JOIN wp_users u ON u.ID=CAST(customer_meta.meta_value AS UNSIGNED)
WHERE p.post_type='arraysubs_data' AND p.post_date_gmt>'2026-08-12 15:22:06'
ORDER BY p.ID;

SELECT 'NEW_SLT_GATEWAY_META_AUDIT' AS section,p.ID,pm.meta_key,COUNT(*) AS row_count,COUNT(DISTINCT pm.meta_value) AS distinct_values,GROUP_CONCAT(pm.meta_value ORDER BY pm.meta_id SEPARATOR ' || ') AS values_seen
FROM wp_posts p
JOIN wp_postmeta product_meta ON product_meta.post_id=p.ID AND product_meta.meta_key='_product_id'
JOIN wp_posts pr ON pr.ID=CAST(product_meta.meta_value AS UNSIGNED) AND pr.post_title LIKE 'SLT %'
JOIN wp_postmeta pm ON pm.post_id=p.ID AND pm.meta_key IN ('_payment_gateway','_gateway_status','_gateway_customer_id','_payment_method_last4')
WHERE p.post_type='arraysubs_data' AND p.post_date_gmt>'2026-08-12 15:22:06'
GROUP BY p.ID,pm.meta_key ORDER BY p.ID,pm.meta_key;

SELECT 'RESTORED_GATEWAY_META' AS section,p.ID,pm.meta_key,pm.meta_value,pm.meta_id
FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID AND pm.meta_key IN ('_gateway_status','_payment_method_updated_at')
WHERE p.ID IN (11959,12234,12655,12003,12017)
ORDER BY p.ID,pm.meta_key,pm.meta_id;
