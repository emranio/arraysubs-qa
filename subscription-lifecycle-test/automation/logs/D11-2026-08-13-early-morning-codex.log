exec
/bin/bash -lc "wp db query --allow-root <<'SQL'
SELECT 'TAIL_ALL_ACTIONS_BY_FIRST_ARG' AS section,JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) AS sub_id,action_id,hook,status,scheduled_date_gmt,last_attempt_gmt,args
FROM wp_actionscheduler_actions
WHERE JSON_VALID(args)=1 AND JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) IN ('12003','12039','12172','12564','12749','12786','13277') AND hook LIKE 'arraysubs_%'
ORDER BY CAST(JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) AS UNSIGNED), scheduled_date_gmt, action_id;

SELECT 'LIFETIME_ABSOLUTE_ACTION_COUNT' AS section,JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) AS sub_id,COUNT(*) AS rows_found
FROM wp_actionscheduler_actions
WHERE JSON_VALID(args)=1 AND JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) IN ('12003','12786') AND hook LIKE 'arraysubs_%'
GROUP BY sub_id;

SELECT 'LIFETIME_RENEWAL_ORDER_COUNT' AS section,m.meta_value AS sub_id,COUNT(DISTINCT o.id) AS renewal_orders
FROM wp_wc_orders_meta m JOIN wp_wc_orders o ON o.id=m.order_id
WHERE m.meta_key IN ('_subscription_id','_subscription_renewal') AND m.meta_value IN ('12003','12786') AND o.type='shop_order'
GROUP BY m.meta_value;
SQL" in /home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
