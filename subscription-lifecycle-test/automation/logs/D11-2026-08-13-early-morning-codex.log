/bin/bash -lc "wp db query --allow-root <<'SQL'
SELECT 'LIVE_CUTOFF' AS section, UTC_TIMESTAMP() AS utc_now, DATE_ADD(UTC_TIMESTAMP(), INTERVAL 6 HOUR) AS site_now;

SELECT 'TAIL_STATE' AS section,p.ID,pr.post_title AS product,p.post_status,u.user_email,
 MAX(CASE WHEN pm.meta_key='_payment_gateway' THEN pm.meta_value END) AS gateway,
 MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END) AS next_payment,
 MAX(CASE WHEN pm.meta_key='_end_date' THEN pm.meta_value END) AS end_date,
 MAX(CASE WHEN pm.meta_key='_completed_payments' THEN pm.meta_value END) AS completed_payments
FROM wp_posts p
LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID
LEFT JOIN wp_posts pr ON pr.ID=(SELECT CAST(x.meta_value AS UNSIGNED) FROM wp_postmeta x WHERE x.post_id=p.ID AND x.meta_key='_product_id' LIMIT 1)
LEFT JOIN wp_users u ON u.ID=(SELECT CAST(y.meta_value AS UNSIGNED) FROM wp_postmeta y WHERE y.post_id=p.ID AND y.meta_key='_customer_id' LIMIT 1)
WHERE p.ID IN (12003,12039,12172,12564,12749,12786,13277)
GROUP BY p.ID,pr.post_title,p.post_status,u.user_email ORDER BY p.ID;

SELECT 'TAIL_ACTIONS' AS section,JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) AS sub_id,action_id,hook,status,scheduled_date_gmt,last_attempt_gmt
FROM wp_actionscheduler_actions
WHERE hook LIKE 'arraysubs_%' AND args IN ('[12003]','[12039]','[12172]','[12564]','[12749]','[12786]','[13277]')
ORDER BY CAST(JSON_UNQUOTE(JSON_EXTRACT(args,'"'$[0]'"')) AS UNSIGNED), scheduled_date_gmt, action_id;

