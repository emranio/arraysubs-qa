/bin/bash -lc "set -e
SESSION='admin-SLT-SETUP-04'
STATE='/root/.agent-browser/slt-admin-auth.json'
URL='https://mirror-help.arrayhash.com/wp-admin/post-new.php?post_type=shop_coupon'
create_coupon() {
  code=\""'$1"; dtype="$2"; amount="$3"; apply="$4"; duration="$5"; cycles="$6"; count_initial="$7"; shot="$8"
  agent-browser --session "$SESSION" open --state "$STATE" "$URL"
  agent-browser --session "$SESSION" wait --load networkidle
  agent-browser --session "$SESSION" snapshot -i -s '"'#poststuff'
  agent-browser --session \""'$SESSION" fill '"'#title' \""'$code"
  agent-browser --session "$SESSION" fill '"'#woocommerce-coupon-description' 'SLT window coupon — delete on 2026-08-15'
  agent-browser --session \""'$SESSION" select '"'#discount_type' \""'$dtype"
  agent-browser --session "$SESSION" fill '"'#coupon_amount' \""'$amount"
  agent-browser --session "$SESSION" fill '"'#expiry_date' '2026-08-15'
  if [ \""'$apply" = yes ]; then agent-browser --session "$SESSION" check '"'#_arraysubs_apply_to_subscriptions'; else agent-browser --session \""'$SESSION" uncheck '"'#_arraysubs_apply_to_subscriptions'; fi
  agent-browser --session \""'$SESSION" select '"'#_arraysubs_discount_duration' \""'$duration"
  agent-browser --session "$SESSION" fill '"'#_arraysubs_discount_cycles' \""'$cycles"
  if [ "$count_initial" = yes ]; then agent-browser --session "$SESSION" check '"'#_arraysubs_count_initial_checkout'; else agent-browser --session \""'$SESSION" uncheck '"'#_arraysubs_count_initial_checkout'; fi
  agent-browser --session \""'$SESSION" snapshot -i -s '"'#woocommerce-coupon-data'
  agent-browser --session \""'$SESSION" click '"'#publish'
  agent-browser --session \""'$SESSION" wait --load networkidle
  agent-browser --session "$SESSION" snapshot -i -s '"'#woocommerce-coupon-data'
  agent-browser --session \""'$SESSION" screenshot --full "$shot"
  agent-browser --session "$SESSION" get url
}
