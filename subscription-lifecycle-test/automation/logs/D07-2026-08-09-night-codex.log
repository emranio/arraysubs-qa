    printf '"'ACTION_TRANSITION status=%s utc=%s\\n' \""'$status" "$(date -u '"'+%Y-%m-%d %H:%M:%S')\"
    break
  fi
  now_epoch="'$(date -u +%s)
  if [ "$now_epoch" -ge "$cutoff_epoch" ]; then
    printf '"'ACTION_CUTOFF_PENDING utc=%s\\n' \""'$(date -u '"'+%Y-%m-%d %H:%M:%S')\"
    break
  fi
  sleep 10
done
while true; do
  now_epoch="'$(date -u +%s)
  remaining=$((cutoff_epoch-now_epoch))
  if [ "$remaining" -le 0 ]; then break; fi
  if [ "$remaining" -gt 30 ]; then sleep 30; else sleep "$remaining"; fi
done
