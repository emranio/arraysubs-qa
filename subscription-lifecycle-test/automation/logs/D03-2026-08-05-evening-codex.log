  {
    "id": 28,
    "title": "Two-active and one-active partitions, and that META_SEG1_END is positional",
    "status": "done",
    "priority": "high",
    "created": "2026-08-02T03:43:05.286065313+02:00",
    "updated": "2026-08-03T09:28:27.037027378+02:00",
