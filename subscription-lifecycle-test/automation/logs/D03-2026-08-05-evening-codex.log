  {
    "id": 87,
    "title": "Mid-cycle Basic→Pro upgrade, then prove the D6 renewal charges $15.00 on the unchanged due date",
    "status": "todo",
    "priority": "critical",
    "created": "2026-08-02T03:43:10.441543701+02:00",
    "updated": "2026-08-02T03:43:21.432660934+02:00",
    "tags": [
      "plan-switching",
