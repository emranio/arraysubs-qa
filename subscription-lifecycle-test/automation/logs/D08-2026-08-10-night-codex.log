codex
Subscription `13331` has now emitted its success mail naturally. I’m performing the final persisted read for its single-line `$10.00` renewal, then I’ll freeze the post-D08 cursor as two separately named early-D09 baselines and register both with their pending action/order state.
exec
/bin/bash -lc "wp db query \"
SELECT a.action_id,a.hook,a.status,a.scheduled_date_gmt,a.last_attempt_gmt,g.slug AS grp,a.args FROM wp_actionscheduler_actions a LEFT JOIN wp_actionscheduler_groups g ON g.group_id=a.group_id WHERE a.action_id=16522;
SELECT l.action_id,l.message,l.log_date_gmt FROM wp_actionscheduler_logs l WHERE l.action_id=16522 ORDER BY l.log_id;
SELECT p.ID,p.post_status,MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END) AS next_payment,MAX(CASE WHEN pm.meta_key='_last_payment_date' THEN pm.meta_value END) AS last_payment,MAX(CASE WHEN pm.meta_key='_completed_payments' THEN pm.meta_value END) AS completed_payments,MAX(CASE WHEN pm.meta_key='_pending_renewal_order_id' THEN pm.meta_value END) AS pending_order,MAX(CASE WHEN pm.meta_key='_payment_retry_attempts' THEN pm.meta_value END) AS retries,MAX(CASE WHEN pm.meta_key='_customer_id' THEN pm.meta_value END) AS customer_id,MAX(CASE WHEN pm.meta_key='_product_id' THEN pm.meta_value END) AS product_id FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID WHERE p.ID IN (13331,11991,12564,12172) GROUP BY p.ID,p.post_status ORDER BY p.ID;
SELECT o.id,o.status,o.total_amount,o.payment_method,o.transaction_id,o.customer_id,o.date_created_gmt,MAX(CASE WHEN om.meta_key='_subscription_id' THEN om.meta_value END) AS subscription_id,MAX(CASE WHEN om.meta_key='_subscription_renewal' THEN om.meta_value END) AS renewal,MAX(CASE WHEN om.meta_key='_renewal_cycle_number' THEN om.meta_value END) AS cycle,MAX(CASE WHEN om.meta_key='_renewal_scheduled_date' THEN om.meta_value END) AS scheduled_cycle FROM wp_wc_orders o LEFT JOIN wp_wc_orders_meta om ON om.order_id=o.id AND om.meta_key IN ('_subscription_id','_subscription_renewal','_renewal_cycle_number','_renewal_scheduled_date') WHERE o.id IN (13625,13658,13674) GROUP BY o.id,o.status,o.total_amount,o.payment_method,o.transaction_id,o.customer_id,o.date_created_gmt ORDER BY o.id;
SELECT oi.order_id,oi.order_item_id,oi.order_item_name,oi.order_item_type,MAX(CASE WHEN oim.meta_key='_product_id' THEN oim.meta_value END) AS product_id,MAX(CASE WHEN oim.meta_key='_qty' THEN oim.meta_value END) AS qty,MAX(CASE WHEN oim.meta_key='_line_total' THEN oim.meta_value END) AS line_total FROM wp_woocommerce_order_items oi LEFT JOIN wp_woocommerce_order_itemmeta oim ON oim.order_item_id=oi.order_item_id WHERE oi.order_id IN (13625,13658,13674) GROUP BY oi.order_id,oi.order_item_id,oi.order_item_name,oi.order_item_type ORDER BY oi.order_id,oi.order_item_id;
SELECT a.action_id,a.hook,a.status,a.scheduled_date_gmt,a.last_attempt_gmt,g.slug AS grp,a.args FROM wp_actionscheduler_actions a LEFT JOIN wp_actionscheduler_groups g ON g.group_id=a.group_id WHERE a.action_id IN (16552,15807,16167) OR (a.args='[13331]' AND a.status='pending') ORDER BY a.scheduled_date_gmt;
SELECT COUNT(*) AS failed_arraysubs_36h FROM wp_actionscheduler_actions WHERE status='failed' AND hook LIKE 'arraysubs%' AND last_attempt_gmt >= UTC_TIMESTAMP() - INTERVAL 36 HOUR;
