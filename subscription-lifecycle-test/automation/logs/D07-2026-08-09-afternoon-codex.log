I caught and corrected a watcher-loop flaw before either 18:xx gate: after finding the first matching mail, it now advances its immutable cursor and waits for true duplicates instead of repeatedly returning the same message. No baseline had been taken and no site state was touched.
exec
/bin/bash -lc 'set -u
WP_ROOT=/home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
site_now() {
  wp --path="$WP_ROOT" --allow-root eval '"'echo current_time(\"Y-m-d H:i:s\");' 2>/dev/null
}
wait_until_site() {
  target=\""'$1"
  while true; do
    current="$(site_now)"
    current_epoch="$(TZ=Etc/GMT-6 date -d "$current" +%s)"
    target_epoch="$(TZ=Etc/GMT-6 date -d "$target" +%s)"
    remain=$((target_epoch-current_epoch))
    if [ "$remain" -le 0 ]; then
      printf '"'GATE_REACHED target=%s current=%s\\n' \""'$target" "$current"
      return
    fi
    if [ "$remain" -gt 30 ]; then pause=30; else pause="$remain"; fi
    sleep "$pause"
  done
}
snapshot_sub() {
  sub="$1"
  action="$2"
  order="$3"
  printf '"'SNAPSHOT site=%s sub=%s action=%s order=%s\\n' \""'$(site_now)" "$sub" "$action" "$order"
  wp --path="$WP_ROOT" --allow-root db query "
    SELECT p.ID,p.post_status,
      MAX(CASE WHEN pm.meta_key='"'_next_payment_date' THEN pm.meta_value END) next_payment,
      MAX(CASE WHEN pm.meta_key='_completed_payments' THEN pm.meta_value END) completed_payments,
      MAX(CASE WHEN pm.meta_key='_pending_renewal_order_id' THEN pm.meta_value END) pending_order,
      MAX(CASE WHEN pm.meta_key='_last_gateway_transaction_id' THEN pm.meta_value END) last_gateway_txn
    FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID
    WHERE p.ID="'$sub GROUP BY p.ID;
    SELECT a.action_id,a.hook,a.status,a.scheduled_date_gmt,a.attempts,
      GROUP_CONCAT(CONCAT(l.log_date_gmt,'"' ',l.message) ORDER BY l.log_id SEPARATOR ' || ') logs
    FROM wp_actionscheduler_actions a
    LEFT JOIN wp_actionscheduler_logs l ON l.action_id=a.action_id
    WHERE a.action_id="'$action GROUP BY a.action_id;
    SELECT o.id,o.status,o.total_amount,o.payment_method,o.transaction_id,o.customer_id,o.date_created_gmt,
      GROUP_CONCAT(CONCAT(m.meta_key,'"'=',m.meta_value) ORDER BY m.meta_key SEPARATOR ' | ') relation_meta
    FROM wp_wc_orders o
    LEFT JOIN wp_wc_orders_meta m ON m.order_id=o.id AND m.meta_key IN ('_subscription_id','_subscription_renewal','_is_renewal_order','_renewal_scheduled_date','_subscription_cycle')
    WHERE o.id="'$order GROUP BY o.id;
    SELECT oi.order_item_id,oi.order_item_name,
      GROUP_CONCAT(CONCAT(oim.meta_key,'"'=',oim.meta_value) ORDER BY oim.meta_key SEPARATOR ' | ') item_meta
    FROM wp_woocommerce_order_items oi
    LEFT JOIN wp_woocommerce_order_itemmeta oim ON oim.order_item_id=oi.order_item_id
    WHERE oi.order_id="'$order GROUP BY oi.order_item_id,oi.order_item_name;
    SELECT o.id,o.status,o.total_amount,o.transaction_id,o.date_created_gmt
    FROM wp_wc_orders o JOIN wp_wc_orders_meta m ON m.order_id=o.id
    WHERE m.meta_key IN ('"'_subscription_id','_subscription_renewal') AND m.meta_value='"'$sub'"'
    GROUP BY o.id ORDER BY o.id;
  \" 2>&1
}
watch_one() {
  sub=\""'$1"
  action="$2"
  order="$3"
  baseline_at="$4"
  gate_at="$5"
  cutoff_at="$6"
  subject="Payment received for subscription #$sub"
  wait_until_site "$baseline_at"
  base="$(/usr/local/bin/mailpit-agent latest-id || true)"
  [ -n "$base" ] || base=none
  cursor="$base"
  matches=0
  printf '"'BASELINE sub=%s site=%s mail=%s\\n' \""'$sub" "$(site_now)" "$base"
  snapshot_sub "$sub" "$action" "$order"
  wait_until_site "$gate_at"
  printf '"'MAIL_WAIT_BEGIN sub=%s gate_site=%s\\n' \""'$sub" "$(site_now)"
  while true; do
    current="$(site_now)"
    current_epoch="$(TZ=Etc/GMT-6 date -d "$current" +%s)"
    cutoff_epoch="$(TZ=Etc/GMT-6 date -d "$cutoff_at" +%s)"
    remain=$((cutoff_epoch-current_epoch))
    if [ "$remain" -le 0 ]; then break; fi
    if [ "$remain" -gt 60 ]; then timeout=60; else timeout="$remain"; fi
    set +e
    mail_out="$(/usr/local/bin/mailpit-agent wait-new "$cursor" "$timeout" "$subject" 2>&1)"
    rc=$?
    set -e
    printf '"'MAIL_WAIT sub=%s site=%s rc=%s cursor=%s\\n' \""'$sub" "$(site_now)" "$rc" "$cursor"
    if [ "$rc" -eq 0 ]; then
      printf '"'%s\\n' \""'$mail_out"
      match_id="$(printf '"'%s\\n' \""'$mail_out" | jq -r '"'.ID // .id // empty' 2>/dev/null)\"
      if [ -n \""'$match_id" ]; then cursor="$match_id"; else cursor="$(/usr/local/bin/mailpit-agent latest-id || true)"; fi
      matches=$((matches+1))
    fi
  done
  printf '"'MAIL_MATCH_COUNT sub=%s count=%s\\n' \""'$sub" "$matches"
  snapshot_sub "$sub" "$action" "$order"
  printf '"'MAIL_LATEST sub=%s baseline=%s latest=%s\\n' \""'$sub" "$base" "$(/usr/local/bin/mailpit-agent latest-id || true)"
  /usr/local/bin/mailpit-agent list 80
}
