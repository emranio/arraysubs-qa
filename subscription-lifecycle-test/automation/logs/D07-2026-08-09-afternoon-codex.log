/bin/bash -lc "wp db query \"SELECT a.action_id,a.hook,a.status,a.attempts,a.scheduled_date_gmt,a.last_attempt_gmt,GROUP_CONCAT(CONCAT(l.log_date_gmt,' ',l.message) ORDER BY l.log_id SEPARATOR ' || ') AS logs FROM wp_actionscheduler_actions a LEFT JOIN wp_actionscheduler_logs l ON l.action_id=a.action_id WHERE a.action_id IN (16049,16050,16054,16055,16438,16439,16449,16450) GROUP BY a.action_id,a.hook,a.status,a.attempts,a.scheduled_date_gmt,a.last_attempt_gmt ORDER BY a.action_id; SELECT p.ID,p.post_status,MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END) next_payment,MAX(CASE WHEN pm.meta_key='_completed_payments' THEN pm.meta_value END) cycles,MAX(CASE WHEN pm.meta_key='_pending_renewal_order_id' THEN pm.meta_value END) pending_order FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID WHERE p.post_type='arraysubs_data' AND p.ID IN (12221,12719) GROUP BY p.ID,p.post_status ORDER BY p.ID; SELECT CAST(om.meta_value AS UNSIGNED) sub_id,o.id,o.status,o.total_amount,o.customer_id FROM wp_wc_orders_meta om JOIN wp_wc_orders o ON o.id=om.order_id WHERE om.meta_key='_subscription_id' AND CAST(om.meta_value AS UNSIGNED) IN (12221,12719) ORDER BY sub_id,o.id; SELECT oi.order_id,oi.order_item_id,oi.order_item_type,oi.order_item_name,MAX(CASE WHEN im.meta_key='_product_id' THEN im.meta_value END) product_id,MAX(CASE WHEN im.meta_key='_qty' THEN im.meta_value END) qty,MAX(CASE WHEN im.meta_key='_line_total' THEN im.meta_value END) line_total FROM wp_woocommerce_order_items oi LEFT JOIN wp_woocommerce_order_itemmeta im ON im.order_item_id=oi.order_item_id WHERE oi.order_id IN (13453,13456) GROUP BY oi.order_id,oi.order_item_id,oi.order_item_type,oi.order_item_name ORDER BY oi.order_id,oi.order_item_id; SELECT a.action_id,a.hook,a.status,a.last_attempt_gmt FROM wp_actionscheduler_actions a WHERE a.hook LIKE 'arraysubs%' AND a.status='failed' AND a.last_attempt_gmt >= DATE_SUB(UTC_TIMESTAMP(),INTERVAL 36 HOUR) ORDER BY a.last_attempt_gmt,a.action_id;\" --allow-root" in /home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
