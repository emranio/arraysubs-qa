        - image
  - main
    - alert
      - StaticText "Paddle checkout setup failed: No valid items found for Paddle checkout."
    - form
      - table
        - rowgroup
          - row
            - columnheader "Product" [ref=e6]
            - columnheader "Qty" [ref=e7]
            - columnheader "Totals" [ref=e8]
        - rowgroup
          - row
            - rowheader "Subtotal:" [ref=e9]
            - cell "$0.00" [ref=e10]
              - StaticText "$0.00"
          - row
            - rowheader "Plan Upgrade to SLT Plan Pro – Proration:" [ref=e11]
            - cell "$9.90" [ref=e12]
              - StaticText "$9.90"
          - row
            - rowheader "Total:" [ref=e13]
            - cell "$9.90" [ref=e14]
              - StaticText "$9.90"
          - row
            - rowheader "Payment method:" [ref=e15]
            - cell "Paddle" [ref=e16]
