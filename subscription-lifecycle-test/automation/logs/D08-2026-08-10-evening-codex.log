nscheduler_actions WHERE status='failed' AND hook LIKE 'arraysubs%' AND last_attempt_gmt >= UTC_TIMESTAMP() - INTERVAL 36 HOUR;\" --allow-root" in /home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
