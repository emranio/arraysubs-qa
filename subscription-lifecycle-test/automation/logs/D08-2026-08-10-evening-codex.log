728:For sessions with expiring tokens:
729-
730-```bash
731-#!/bin/bash
--
738-    agent-browser state load "$STATE_FILE"
739-    agent-browser open https://app.example.com/dashboard
740-
741:    # Check if session is still valid
742-    URL=$(agent-browser get url)
743-    if [[ "$URL" == *"/login"* ]]; then
744-        echo "Session expired, re-authenticating..."
