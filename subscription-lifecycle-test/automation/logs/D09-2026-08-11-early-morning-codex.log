Resolution and query basis
--------------------------
SLT ownership was resolved relationship-first: args[0] had to be a numeric arraysubs_data ID
whose numeric _product_id points to a product title beginning "SLT ". The full resolved current
SLT set is:

11959, 11991, 12003, 12017, 12039, 12147, 12172, 12193, 12221, 12234,
12263, 12318, 12332, 12564, 12639, 12655, 12684, 12719, 12749, 12760,
12786, 13277, 13331, 13344, 13402

SELECT a.action_id, a.hook, a.scheduled_date_gmt,
       DATE_ADD(a.scheduled_date_gmt, INTERVAL 6 HOUR) AS scheduled_site,
       g.slug AS action_group, a.args, p.ID AS sub_id, p.post_status,
       product.ID AS product_id, product.post_title
FROM wp_actionscheduler_actions a
JOIN wp_posts p
  ON p.ID=CAST(JSON_UNQUOTE(JSON_EXTRACT(a.args,'$[0]')) AS UNSIGNED)
 AND p.post_type='arraysubs_data'
JOIN wp_postmeta product_ref
  ON product_ref.post_id=p.ID AND product_ref.meta_key='_product_id'
JOIN wp_posts product
  ON product.ID=CAST(product_ref.meta_value AS UNSIGNED)
 AND product.post_title LIKE 'SLT %'
LEFT JOIN wp_actionscheduler_groups g ON g.group_id=a.group_id
WHERE a.status='pending'
  AND a.scheduled_date_gmt <= DATE_ADD(UTC_TIMESTAMP(), INTERVAL 72 HOUR)
  AND JSON_VALID(a.args)
ORDER BY a.scheduled_date_gmt, a.action_id;

