exec
/bin/bash -lc "set -euo pipefail
SESSION='admin-SLT-SYN-10'
AB=(agent-browser --no-auto-dialog --session \""'$SESSION")
ADMIN_USER=$(awk -F'"'"'`'"' '/"'^'"\\| Admin \\|/{print "'$4; exit}'"' README.md)
ADMIN_PASS="'$(awk -F'"'"'`'"' '/"'^'"\\| Admin \\|/{print "'$6; exit}'"' README.md)
\""'${AB[@]}" open '"'https://mirror-help.arrayhash.com/wp-admin/tools.php?page=action-scheduler&status=pending&s=13277' >/dev/null
\""'${AB[@]}" snapshot -i >/dev/null
"${AB[@]}" fill '"'@e5' \""'$ADMIN_USER" >/dev/null
"${AB[@]}" fill '"'@e6' \""'$ADMIN_PASS" >/dev/null
"${AB[@]}" click '"'@e9' >/dev/null
\""'${AB[@]}" wait 5000 >/dev/null
SNAP=$("${AB[@]}" snapshot -i)
printf '"'%s\\n' \""'$SNAP"
printf '"'%s\\n' '=== STRICT INVOICE-COMPLETE / CHARGE-PENDING PREFLIGHT ==='
wp db query \"SELECT action_id,hook,status,args,attempts FROM wp_actionscheduler_actions WHERE action_id IN (16638,16639) ORDER BY action_id\" --allow-root
PAIR_OK="'$(wp db query "SELECT COUNT(*) FROM wp_actionscheduler_actions WHERE (action_id=16638 AND hook='"'arraysubs_generate_renewal_invoice' AND status='complete' AND attempts=1 AND JSON_UNQUOTE(JSON_EXTRACT(args,'\\"'$[0]'"'))='13277') OR (action_id=16639 AND hook='arraysubs_process_renewal' AND status='pending' AND attempts=0 AND JSON_UNQUOTE(JSON_EXTRACT(args,'\\"'$[0]'"'))='13277')\" --skip-column-names --allow-root | tr -d '\\r\\n')
[ \""'$PAIR_OK" = 2 ]
CHARGE_REF=$(printf '"'%s\\n' \""'$SNAP" | sed -n '"'/cell \"arraysubs_process_renewal Run | Cancel\"/,/cell \"Pending\"/p' | sed -n 's/.*link \"Run\" \\[ref=\\(["'^]]*'"\\)\\].*/\\1/p')
[ -n \""'$CHARGE_REF" ]
printf '"'CLICKING_EXACT_CHARGE_ACTION=16639 REF=%s\\n' \""'$CHARGE_REF"
"${AB[@]}" click "@$CHARGE_REF"
