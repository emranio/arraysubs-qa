wp db query \"SELECT p.ID,p.post_status,MAX(CASE WHEN pm.meta_key='_customer_id' THEN pm.meta_value END) customer_id,MAX(CASE WHEN pm.meta_key='_product_id' THEN pm.meta_value END) product_id,MAX(CASE WHEN pm.meta_key='_payment_method' THEN pm.meta_value END) gateway,MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END) next_payment,MAX(CASE WHEN pm.meta_key='_end_date' THEN pm.meta_value END) end_date,MAX(CASE WHEN pm.meta_key='_completed_payments' THEN pm.meta_value END) payments,MAX(CASE WHEN pm.meta_key='_recurring_amount' THEN pm.meta_value END) recurring FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID WHERE p.ID IN (11959,11991,12003,12017,12039,12172,12193,12234,12263,12564,12639,12655,12749,12786,13277,13402) GROUP BY p.ID ORDER BY p.ID;\" --allow-root
