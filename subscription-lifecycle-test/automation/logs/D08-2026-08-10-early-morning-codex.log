"${AB[@]}" click '"'@e9' >/dev/null
\""'${AB[@]}" wait 5000 >/dev/null
SNAP=$("${AB[@]}" snapshot -i)
INVOICE_REF=$(printf '"'%s\\n' \""'$SNAP" | sed -n '"'/cell \"arraysubs_generate_renewal_invoice Run | Cancel\"/,/cell \"Pending\"/p' | sed -n 's/.*link \"Run\" \\[ref=\\(["'^]]*'"\\)\\].*/\\1/p')
[ -n \""'$INVOICE_REF" ] || exit 20
HREF=$("${AB[@]}" get attr href "@$INVOICE_REF")
printf '"'EXACT_INVOICE_ACTION=16638 REF=%s HREF_HAS_ACTION_ID=%s\\n' \""'$INVOICE_REF" "$(printf '"'%s' \""'$HREF" | grep -c '"'action_id=16638')\"
\""'${AB[@]}" hover '"'@e149' >/dev/null || true
\""'${AB[@]}" click "@$INVOICE_REF"
DIALOG=$("${AB[@]}" dialog status 2>&1 || true)
