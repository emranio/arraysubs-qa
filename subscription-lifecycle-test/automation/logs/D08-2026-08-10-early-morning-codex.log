wp db query \"SELECT p.ID AS sub_id,p.post_status,u.user_login,MAX(CASE WHEN pm.meta_key='_customer_id' THEN pm.meta_value END) customer_id,MAX(CASE WHEN pm.meta_key='_product_id' THEN pm.meta_value END) product_id,prod.post_title,COALESCE(MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END),'') next_payment FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID LEFT JOIN wp_posts prod ON prod.ID=(SELECT meta_value FROM wp_postmeta x WHERE x.post_id=p.ID AND x.meta_key='_product_id' LIMIT 1) LEFT JOIN wp_users u ON u.ID=(SELECT meta_value FROM wp_postmeta y WHERE y.post_id=p.ID AND y.meta_key='_customer_id' LIMIT 1) WHERE p.post_type='arraysubs_data' AND (prod.post_title LIKE 'SLT %' OR u.user_login LIKE 'slt-%') GROUP BY p.ID,p.post_status,u.user_login,prod.post_title ORDER BY p.ID;\" --allow-root
wp db query \"SELECT p.ID AS sub_id,p.post_status,MAX(CASE WHEN pm.meta_key='_next_payment_date' THEN pm.meta_value END) next_payment FROM wp_posts p LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID WHERE p.post_type='arraysubs_data' AND p.ID IN (648,7353,7809,8034,8682,8705,8728,8751,8776,8805,8969,8992,9092) GROUP BY p.ID,p.post_status ORDER BY p.ID;\" --allow-root
wp db query \"SELECT u.ID,u.user_login,p.ID AS sub_id,p.post_status,MAX(CASE WHEN pm.meta_key='_product_id' THEN pm.meta_value END) product_id,MAX(CASE WHEN pm.meta_key='_parent_order_id' THEN pm.meta_value END) parent_order FROM wp_users u LEFT JOIN wp_postmeta cm ON cm.meta_key='_customer_id' AND cm.meta_value=CAST(u.ID AS CHAR) LEFT JOIN wp_posts p ON p.ID=cm.post_id AND p.post_type='arraysubs_data' LEFT JOIN wp_postmeta pm ON pm.post_id=p.ID WHERE u.ID IN (349,354,355) GROUP BY u.ID,u.user_login,p.ID,p.post_status ORDER BY u.ID,p.ID;\" --allow-root
wp db query \"SELECT a.action_id,a.hook,a.status,a.args,a.scheduled_date_gmt,a.last_attempt_gmt FROM wp_actionscheduler_actions a WHERE a.hook LIKE 'arraysubs%' AND a.status='failed' AND a.last_attempt_gmt >= DATE_SUB(UTC_TIMESTAMP(),INTERVAL 36 HOUR) ORDER BY a.last_attempt_gmt DESC;\" --allow-root" in /home/server-manager/www/arrayhash/mirror-help.arrayhash.com/public
