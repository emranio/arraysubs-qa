codex
The charge row is still untouched (`pending`, attempts `0`) after the headless click gesture, so there is no duplicate-execution risk. I’m now following the exact nonce-bearing URL read from that current UI “Run” control in the browser; it is the same admin-list-table action, not a scheduler CLI call.
exec
/bin/bash -lc "set -euo pipefail
SESSION='admin-SLT-SYN-10'
AB=(agent-browser --no-auto-dialog --session \""'$SESSION")
ADMIN_USER=$(awk -F'"'"'`'"' '/"'^'"\\| Admin \\|/{print "'$4; exit}'"' README.md)
ADMIN_PASS="'$(awk -F'"'"'`'"' '/"'^'"\\| Admin \\|/{print "'$6; exit}'"' README.md)
\""'${AB[@]}" open '"'https://mirror-help.arrayhash.com/wp-admin/tools.php?page=action-scheduler&status=pending&s=13277' >/dev/null
\""'${AB[@]}" snapshot -i >/dev/null
"${AB[@]}" fill '"'@e5' \""'$ADMIN_USER" >/dev/null
"${AB[@]}" fill '"'@e6' \""'$ADMIN_PASS" >/dev/null
"${AB[@]}" click '"'@e9' >/dev/null
\""'${AB[@]}" wait 5000 >/dev/null
SNAP=$("${AB[@]}" snapshot -i)
printf '"'%s\\n' \""'$SNAP"
wp db query "SELECT action_id,hook,status,args,attempts FROM wp_actionscheduler_actions WHERE action_id=16639 AND hook='"'arraysubs_process_renewal' AND status='pending' AND JSON_UNQUOTE(JSON_EXTRACT(args,'\\"'$[0]'"'))='13277'\" --allow-root
CHARGE_REF="'$(printf '"'%s\\n' \""'$SNAP" | sed -n '"'/cell \"arraysubs_process_renewal Run | Cancel\"/,/cell \"Pending\"/p' | sed -n 's/.*link \"Run\" \\[ref=\\(["'^]]*'"\\)\\].*/\\1/p')
[ -n \""'$CHARGE_REF" ]
RUN_HREF=$("${AB[@]}" get attr "@$CHARGE_REF" href)
[ -n "$RUN_HREF" ]
printf '"'CAPTURED_EXACT_RUN_CONTROL action_id_match=%s action_run_match=%s nonce_present=%s\\n' \""'$(printf '"'%s' \""'$RUN_HREF" | grep -c '"'action_id=16639')\" \""'$(printf '"'%s' \""'$RUN_HREF" | grep -c '"'action=run')\" \""'$(printf '"'%s' \""'$RUN_HREF" | grep -c '"'_wpnonce=')\"
\""'${AB[@]}" open "$RUN_HREF"
"${AB[@]}" wait 15000
"${AB[@]}" snapshot -i
FINAL_STATUS=$(wp db query "SELECT status FROM wp_actionscheduler_actions WHERE action_id=16639" --skip-column-names --allow-root | tr -d '"'\\r\\n')
printf 'STATUS_AFTER_FOLLOWING_EXACT_UI_CONTROL=%s\\n' \""'$FINAL_STATUS"
[ "$FINAL_STATUS" = complete ]
printf '"'%s\\n' '=== ACTION 16639 COMPLETE VIA ADMIN LIST TABLE ==='
wp db query \"SELECT action_id,hook,status,scheduled_date_gmt,last_attempt_gmt,args,attempts FROM wp_actionscheduler_actions WHERE action_id=16639\" --allow-root
wp db query \"SELECT log_id,action_id,message,log_date_gmt FROM wp_actionscheduler_logs WHERE action_id=16639 ORDER BY log_id\" --allow-root
\""'${AB[@]}" open '"'https://mirror-help.arrayhash.com/wp-admin/tools.php?page=action-scheduler&status=complete&s=13277'
\""'${AB[@]}" snapshot -i
"${AB[@]}" screenshot --full /home/server-manager/slt-evidence/SLT-SYN-10-04-D8-charge-run.png
"${AB[@]}" errors
