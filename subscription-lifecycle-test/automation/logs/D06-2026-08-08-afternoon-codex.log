gn=\"left\">\r\n                <span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">$</span>30.00</span>                /\r\n                Every month            </td>\r\n        </tr>\r\n        <tr>\r\n            <th class=\"td\" scope=\"row\" style=\"color: #414141; border: 0; vertical-align: middle; padding: 12px; text-align: left;\" align=\"left\">Start Date</th>\r\n            <td class=\"td\" style=\"color: #414141; border: 0; vertical-align: middle; padding: 12px; text-align: left;\" align=\"left\">\r\n                8 August, 2026 6:14 PM (UTC+6)            </td>\r\n        </tr>\r\n        <tr>\r\n            <th class=\"td\" scope=\"row\" style=\"color: #414141; border: 0; vertical-align: middle; padding: 12px; text-align: left;\" align=\"left\">Next Payment</th>\r\n            <td class=\"td\" style=\"color: #414141; border: 0; vertical-align: middle; padding: 12px; text-align: left;\" align=\"left\">\r\n                1 October, 2026 12:00 AM (UTC+6)            </td>\r\n        </tr>\r\n            </tbody>\r\n</table>\r\n\r\n<p style=\"margin: 0 0 16px;\">\r\n    <a class=\"link\" href=\"https://mirror-help.arrayhash.com/my-account/subscriptions/\" style=\"font-weight: normal; text-decoration: underline; color: #111;\">\r\n        View your subscription    </a>\r\n</p>\r\n\r\n<p style=\"margin: 0 0 16px;\">Thank you for subscribing! If you have any questions, please contact us.</p>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</table>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<!-- End Content -->\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t\t\t\t\t</table>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<!-- End Body -->\r\n\t\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t\t</table>\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\