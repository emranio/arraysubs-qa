      --sort string         sort field (id, status, priority, created, updated, due) (default "id")
      --status strings      filter by status (comma-separated)
      --tag string          filter by tag
      --unblocked           show only tasks with all dependencies satisfied (missing dependency IDs are treated as satisfied)
